# Copy to `.env` (never commit real secrets) and fill in what you need.
#
# All EXPO_PUBLIC_* variables are inlined into the client bundle at build time,
# so they must NOT contain secrets. They are safe to expose publicly.
#
# By default the app talks to fully public, key-less APIs:
#   - AlQuran Cloud     https://api.alquran.cloud/v1        (recitation audio, per-ayah)
#   - Quran.com API v4  https://api.quran.com/api/v4        (reciter catalog, tafsir editions)
#   - EveryAyah         https://everyayah.com/data          (fallback per-ayah audio)
#
# Optional overrides (only needed if you self-host a proxy or add a key):

# EXPO_PUBLIC_ALQURAN_CLOUD_BASE_URL=https://api.alquran.cloud/v1
# EXPO_PUBLIC_QURAN_COM_BASE_URL=https://api.quran.com/api/v4
# EXPO_PUBLIC_EVERYAYAH_BASE_URL=https://everyayah.com/data

# Optional: override the audio CDN used for full-surah playback.
# EXPO_PUBLIC_AUDIO_CDN_BASE_URL=

# Optional: default reciter identifier (AlQuran Cloud edition identifier).
# EXPO_PUBLIC_DEFAULT_RECITER=ar.alafasy
